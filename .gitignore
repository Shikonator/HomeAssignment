# Bazel's convenience symlinks point into the user's cache directory. In a
# clone they would be broken links, so they must never be committed.
bazel-*

# CLion / CMake leftovers from before the project moved to Bazel.
cmake-build-debug/
.idea/

# Generated by the CLion Bazel plugin on project sync: bundled aspect files and
# .iml module state, tied to the plugin version rather than to this project.
# .bazelproject is the hand-written one and IS committed.
.clwb/

.DS_Store

# The company's own assignment document. Kept locally, never redistributed
# in the repo they will download.
*.pdf
